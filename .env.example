# Desenvolvimento local com docker compose.
# Copie para .env. Os valores abaixo NÃO são aceitáveis em produção.
POSTGRES_DB=eduvault
POSTGRES_USER=eduvault
POSTGRES_PASSWORD=eduvault123
DB_PORT=5432
FRONTEND_PORT=5173
JWT_SECRET=local-only-jwt-secret-with-at-least-32-characters
TRUST_PROXY=1
COOKIE_SECURE=false
AUTH_TTL_HOURS=8
MIGRATION_MODE=deploy
APP_TIMEZONE=America/Sao_Paulo

FRONTEND_URL=http://localhost:5173
PLATFORM_NAME=EduVault
SEED_ON_START=false
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_USERNAME=
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_NAME=Administrador da Plataforma
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

# OBS: rtmp://localhost:1935/live, stream key stream?token=<RTMP_STREAM_KEY>
RTMP_PORT=1935
RTMP_STREAM_KEY=1111111111111111111111111111111111111111111111111111111111111111
LOOP_STREAM_KEY=2222222222222222222222222222222222222222222222222222222222222222

# Integração com Cloudflare R2 (substitui armazenamento local se preenchido)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# A IA fica desabilitada sem chave em desenvolvimento.
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_MODEL_SWITCH_AT=2026-07-17T00:00:00.000Z
GROQ_TIMEOUT_MS=20000
GROQ_MAX_TOKENS=1200
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MS=900000
